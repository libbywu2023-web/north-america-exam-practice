{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "north-america-exam-practice",
	"main": "src/index.js",
	"compatibility_date": "2026-11-04",
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		"run_worker_first": [
			"/api/*"
		]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "exam-practice-db",
			"database_id": "c66aa5ab-25fd-4d2e-8c22-d377a4095194",
			"migrations_dir": "migrations",
      "remote": true
		}
	],
	"observability": {
		"enabled": true
	}
}