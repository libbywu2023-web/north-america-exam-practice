/* Mock test loading indicator */
.loading-state {
  display: flex;
  align-items: center;
  gap: 12px;
  margin: 18px 0;
  color: #52657d;
  font-size: 14px;
}

.loading-spinner {
  width: 22px;
  height: 22px;
  border: 3px solid #e2e8f0;
  border-top-color: #176b3a;
  border-radius: 50%;
  animation: mock-spin 0.75s linear infinite;
  flex-shrink: 0;
}

@keyframes mock-spin {
  to {
    transform: rotate(360deg);
  }
}

.loading-state[hidden] {
  display: none;
}
/* Question image gallery */
.question-images {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10px;
  width: 100%;
  max-width: 560px;
  margin: 0 auto 20px;
}

.question-images[hidden] {
  display: none;
}

.question-image-button {
  display: block;
  width: 100%;
  min-width: 0;
  aspect-ratio: 4 / 3;
  padding: 5px;
  overflow: hidden;
  border: 1px solid #e2e7ee;
  border-radius: 9px;
  background: #f5f7fa;
  cursor: zoom-in;
}

.question-image-button img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: contain;
}

.image-preview {
  position: relative;
  width: min(92vw, 900px);
  max-width: 92vw;
  max-height: 90vh;
  padding: 42px 16px 16px;
  border: 0;
  border-radius: 12px;
  background: #fff;
}

.image-preview::backdrop {
  background: rgba(0, 0, 0, 0.78);
}

.image-preview img {
  display: block;
  max-width: 100%;
  max-height: 78vh;
  width: auto;
  height: auto;
  margin: 0 auto;
  object-fit: contain;
}

.image-preview-close {
  position: absolute;
  top: 5px;
  right: 8px;
  padding: 2px 12px;
  border: 0;
  background: transparent;
  color: #26364a;
  font-size: 28px;
  cursor: pointer;
}

@media (max-width: 600px) {
  .question-images {
    gap: 7px;
    margin-bottom: 16px;
  }

  .question-image-button {
    padding: 3px;
  }
}

/* Homepage country and exam category labels */
.exam-location {
  margin: 0 0 12px;
  letter-spacing: 0.07em;
}

.exam-category {
  display: inline-flex;
  align-items: center;
  margin: 0 0 8px;
  padding: 5px 10px;
  border-radius: 6px;
  background: #eef3f8;
  color: #52657d;
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 0.06em;
}

.exam-card h2 {
  margin-top: 0;
  margin-bottom: 10px;
}

.exam-card > .muted {
  margin-top: 0;
  margin-bottom: 18px;
}

/* Homepage breadcrumb and full-width main action */
.exam-location {
  margin: 0 0 16px;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 7px;
  letter-spacing: 0.045em;
  line-height: 1.8;
}

.main-action-row {
  display: flex;
  width: 100%;
}

.main-action-row .primary {
  display: block;
  width: 100%;
  text-align: center;
  padding: 14px 18px;
  font-size: 15px;
}
