<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Question Review | Exam Practice CMS</title>
  <link rel="stylesheet" href="/admin/css/admin.css">
  <style>
    .review-toolbar {
      display: flex;
      flex-wrap: wrap;
      align-items: end;
      gap: 18px;
      padding: 20px;
      margin-top: 22px;
    }
    .review-field {
      min-width: 190px;
      flex: 1;
    }
    .review-field label {
      display: block;
      margin-bottom: 8px;
      font-weight: 600;
      color: #374151;
    }
    .review-field select {
      width: 100%;
      padding: 10px 12px;
      border: 1px solid #d1d5db;
      border-radius: 7px;
      background: #fff;
    }
    .review-table-card {
      margin-top: 20px;
      padding: 20px;
    }
    .review-table-card .table-heading {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      margin-bottom: 16px;
    }
    .review-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 14px;
    }
    .review-table th,
    .review-table td {
      padding: 12px;
      text-align: left;
      vertical-align: top;
      border-bottom: 1px solid #e5e7eb;
    }
    .review-table th {
      background: #f8fafc;
      white-space: nowrap;
    }
    .review-question-cell {
      min-width: 240px;
      max-width: 440px;
      line-height: 1.5;
    }
    .review-id {
      font-weight: 600;
      color: #374151;
      white-space: nowrap;
    }
    .review-status {
      display: inline-block;
      padding: 4px 9px;
      border-radius: 20px;
      background: #f1f5f9;
      color: #475569;
      font-size: 12px;
      white-space: nowrap;
    }
    .review-status.pending_review { background: #fef3c7; color: #92400e; }
    .review-status.waiting_for_image { background: #ffedd5; color: #9a3412; }
    .review-status.approved { background: #dcfce7; color: #166534; }
    .review-status.rejected { background: #fee2e2; color: #991b1b; }
    .review-status.published { background: #dbeafe; color: #1e40af; }
    .review-action {
      white-space: nowrap;
    }
    .review-detail {
      margin-top: 24px;
      padding: 24px;
    }
    .review-detail-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 16px;
      margin-bottom: 22px;
    }
    .review-detail-section {
      margin-top: 24px;
      padding-top: 20px;
      border-top: 1px solid #e5e7eb;
    }
    .review-detail-section h3 {
      margin: 0 0 14px;
    }
    .review-basic-fields {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 16px;
    }
    .review-form-field {
      margin-bottom: 16px;
    }
    .review-form-field label {
      display: block;
      margin-bottom: 7px;
      font-weight: 600;
      color: #374151;
    }
    .review-form-field input,
    .review-form-field select,
    .review-form-field textarea {
      width: 100%;
      padding: 10px 12px;
      border: 1px solid #d1d5db;
      border-radius: 7px;
      font: inherit;
      background: #fff;
    }
    .review-form-field textarea {
      min-height: 90px;
      resize: vertical;
    }
    .review-language-tabs {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin-bottom: 18px;
    }
    .review-language-tab {
      padding: 8px 14px;
      border: 1px solid #d1d5db;
      border-radius: 7px;
      background: #fff;
      cursor: pointer;
    }
    .review-language-tab.active {
      border-color: #2563eb;
      background: #eff6ff;
      color: #1d4ed8;
      font-weight: 600;
    }
    .review-option {
      display: grid;
      grid-template-columns: 54px minmax(0, 1fr) 110px;
      gap: 12px;
      align-items: start;
      padding: 14px;
      margin-bottom: 12px;
      border: 1px solid #e5e7eb;
      border-radius: 8px;
    }
    .review-option-key {
      font-weight: 700;
      padding-top: 10px;
    }
    .review-option input[type="radio"] {
      margin-right: 6px;
    }
    .review-image-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
      gap: 14px;
    }
    .review-image-item {
      padding: 10px;
      border: 1px solid #e5e7eb;
      border-radius: 8px;
    }
    .review-image-item img {
      display: block;
      width: 100%;
      max-height: 180px;
      object-fit: contain;
      background: #f8fafc;
      border-radius: 5px;
    }
    .review-image-item p {
      overflow-wrap: anywhere;
      font-size: 12px;
      color: #64748b;
    }
    .review-detail-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      justify-content: flex-end;
      margin-top: 24px;
    }
    .review-message {
      margin-top: 14px;
      line-height: 1.6;
      white-space: pre-wrap;
    }
    .review-message.error { color: #dc2626; }
    .review-message.success { color: #15803d; }
    .review-empty {
      padding: 24px;
      text-align: center;
      color: #64748b;
    }
    .hidden { display: none !important; }

    @media (max-width: 768px) {
      .review-toolbar,
      .review-table-card,
      .review-detail {
        padding: 16px;
      }
      .review-basic-fields {
        grid-template-columns: 1fr;
        gap: 0;
      }
      .review-option {
        grid-template-columns: 36px minmax(0, 1fr);
      }
      .review-option-correct {
        grid-column: 2;
      }
      .review-detail-header {
        flex-direction: column;
      }
    }
  </style>
</head>
<body class="dashboard-page">

  <header class="admin-header">
    <a class="admin-brand" href="/admin/dashboard/">
      <span class="admin-logo">EP</span>
      <span>Exam Practice CMS</span>
    </a>
    <div class="admin-header-right">
      <span class="admin-user">Administrator</span>
      <button id="logout-button" class="logout-button">Sign Out</button>
    </div>
  </header>

  <div class="admin-layout">
    <aside class="admin-sidebar">
      <div class="sidebar-label">MAIN MENU</div>
      <a class="sidebar-link" href="/admin/dashboard/">
        <span>▦</span> Dashboard
      </a>

      <div class="sidebar-label">CONTENT MANAGEMENT</div>
      <a class="sidebar-link" href="/admin/countries/"><span>🌎</span> Countries</a>
      <a class="sidebar-link" href="/admin/regions/"><span>📍</span> Regions</a>
      <a class="sidebar-link" href="/admin/categories/"><span>📚</span> Exam Categories</a>
      <a class="sidebar-link" href="/admin/exams/"><span>📝</span> Exams</a>
      <a class="sidebar-link" href="/admin/topics/"><span>📂</span> Topics</a>
      <a class="sidebar-link" href="/admin/questions/"><span>❓</span> Questions</a>
      <a class="sidebar-link" href="/admin/imports/"><span>📥</span> Question Import</a>
      <a class="sidebar-link active" href="/admin/review/"><span>🧐</span> Question Review</a>
      <a class="sidebar-link" href="/admin/languages/"><span>🌐</span> Languages</a>
    </aside>

    <main class="admin-main">
      <div class="page-heading">
        <div>
          <h1>Question Review</h1>
          <p>Review, edit and approve imported questions before publication.</p>
        </div>
      </div>

      <section class="dashboard-welcome">
        <h2>Staging Review Center</h2>
        <p>
          Questions imported from Excel are reviewed here before they can
          enter the published question bank. Changes made here do not directly
          modify existing published questions.
        </p>
      </section>

      <section class="module-card review-toolbar">
        <div class="review-field">
          <label for="review-exam-filter">Exam</label>
          <select id="review-exam-filter">
            <option value="">All exams</option>
          </select>
        </div>
        <div class="review-field">
          <label for="review-status-filter">Review Status</label>
          <select id="review-status-filter">
            <option value="">All review statuses</option>
            <option value="pending_review">Pending Review</option>
            <option value="waiting_for_image">Waiting for Image</option>
            <option value="approved">Approved</option>
            <option value="rejected">Rejected</option>
          </select>
        </div>
        <button type="button" id="refresh-review-button" class="secondary-button">
          Refresh
        </button>
      </section>

      <section class="module-card review-table-card">
        <div class="table-heading">
          <h2>Questions to Review</h2>
          <span id="review-question-count">Loading...</span>
        </div>
        <div class="table-responsive">
          <table class="review-table">
            <thead>
              <tr>
                <th>ID</th>
                <th>Question</th>
                <th>Exam</th>
                <th>Options</th>
                <th>Images</th>
                <th>Status</th>
                <th>Action</th>
              </tr>
            </thead>
            <tbody id="review-table-body">
              <tr><td colspan="7" class="review-empty">Loading questions...</td></tr>
            </tbody>
          </table>
        </div>
        <p id="review-list-message" class="review-message" role="status"></p>
      </section>

      <section id="review-detail" class="module-card review-detail hidden">
        <div class="review-detail-header">
          <div>
            <h2 id="review-detail-title">Review Question</h2>
            <p id="review-detail-subtitle" class="muted-text"></p>
          </div>
          <button type="button" id="close-review-detail" class="secondary-button">
            Close
          </button>
        </div>

        <div class="review-basic-fields">
          <div class="review-form-field">
            <label for="review-topic">Topic</label>
            <select id="review-topic">
              <option value="">No topic</option>
            </select>
          </div>
          <div class="review-form-field">
            <label for="review-difficulty">Difficulty</label>
            <select id="review-difficulty">
              <option value="easy">Easy</option>
              <option value="normal">Normal</option>
              <option value="hard">Hard</option>
            </select>
          </div>
        </div>

        <div class="review-detail-section">
          <h3>Question Translations</h3>
          <div id="review-language-tabs" class="review-language-tabs"></div>
          <div id="review-question-translation"></div>
        </div>

        <div class="review-detail-section">
          <h3>Answer Options</h3>
          <p class="muted-text">
            Select exactly one correct answer. You can edit option text and order.
          </p>
          <div id="review-options"></div>
          <button type="button" id="review-add-option" class="secondary-button">
            + Add Option
          </button>
        </div>

        <div class="review-detail-section">
          <h3>Question Images</h3>
          <p id="review-image-status" class="muted-text"></p>
          <div id="review-images" class="review-image-grid"></div>
        </div>

        <p id="review-save-message" class="review-message" role="status"></p>

        <div class="review-detail-actions">
          <button type="button" id="review-reject" class="secondary-button">
            Reject
          </button>
          <button type="button" id="review-save" class="secondary-button">
            Save Changes
          </button>
          <button type="button" id="review-approve" class="primary-button">
            Approve
          </button>
        </div>
      </section>

      <footer class="admin-footer">
        North America Exam Practice CMS
      </footer>
    </main>
  </div>

  <script src="/admin/js/dashboard.js"></script>
  <script src="/admin/js/review.js"></script>
</body>
</html>
